+proc bindTexture(unit: GLint, textureNum: GLuint) =
+  ## Put `textureNum` on pool unit `unit`, where the entity's sampler uniform
+  ## (set once at `compile`) already points.
+  glActiveTexture(GLenum(GL_TEXTURE0.ord + unit))
+  glBindTexture(GL_TEXTURE_2D, textureNum)
