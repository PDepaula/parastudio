--- paranim/gl.nim (0.12.0)
+++ paranim/gl.nim (patched)
@@ -1,3 +1,23 @@
+## paranim 0.12.0 `gl`, patched for paraloop (see gl.diff for the exact changes
+## against upstream). Upstream gives every texture its own never-reused GL
+## texture unit (`game.texCount`), so a game with more textures than the
+## device has combined texture units (WebGL2 guarantees only 32; one game
+## has 182) logs `INVALID_ENUM: activeTexture: texture unit out of range`,
+## `INVALID_VALUE: glUniform1i: Sampler uniform value out of range`, and draws
+## solid blocks and black squares. Draw-only change; nothing else moves:
+##
+## - Texture units are a small fixed pool (`texturePoolSize`: at most
+##   `defaultTexturePoolSize`, and never more than the device's
+##   `MAX_COMBINED_TEXTURE_IMAGE_UNITS`). The k-th texture uniform of a program
+##   is pinned to pool unit k at `compile`, so the sampler uniform is set once
+##   and every program reuses units 0..k.
+## - `render` binds each texture uniform's texture to its pool unit just before
+##   the draw, unconditionally (no bind cache), so a texture re-uploaded or
+##   deleted behind the engine's back still draws what is bound now.
+## - `game.texCount` still counts the textures created; it is no longer a unit.
+## - A program with more texture uniforms than the pool has units raises at
+##   `compile`, naming the device limit, not at draw time.
+##
 import paranim/opengl
 import paranim/gl/attributes, paranim/gl/uniforms
 from paranim/gl/utils import nil
@@ -34,8 +54,45 @@
     ## Entity that renders using `glDrawElementsInstanced`.
     instanceCount*: GLsizei
 
+const defaultTexturePoolSize* = 16
+  ## The most texture units paraloop will use, whatever the device offers. A
+  ## program needs one per texture uniform (the image entities have one), so
+  ## this is far above what any shader asks for and far below the 32 units
+  ## WebGL2 guarantees.
+
+proc texturePoolSizeFor*(deviceUnits: int, wanted = defaultTexturePoolSize): int =
+  ## The pool size for a device that offers `deviceUnits` combined texture
+  ## units: `wanted`, capped at the device's limit, and at least 1 (a
+  ## `glGetIntegerv` that reported nothing still leaves unit 0 to draw with).
+  max(1, min(wanted, deviceUnits))
+
+var
+  poolSizeCache = 0
+    ## 0 until `texturePoolSize` first asks the context.
+  compileSlot = 0
+    ## Texture uniforms the `compile` in flight has handed a pool unit to.
+
+proc texturePoolSize*(): int =
+  ## Number of texture units paraloop draws with on this device. Needs a
+  ## current GL context the first time it is called.
+  if poolSizeCache == 0:
+    var deviceUnits: GLint
+    glGetIntegerv(GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS, deviceUnits.addr)
+    poolSizeCache = texturePoolSizeFor(int(deviceUnits))
+  poolSizeCache
+
+proc nextPoolUnit(): GLint =
+  ## The pool unit for the next texture uniform of the program being compiled.
+  let pool = texturePoolSize()
+  if compileSlot >= pool:
+    raise newException(Exception, "a program has more texture uniforms than the " &
+      "texture unit pool holds (" & $pool & " units, capped by the device's " &
+      "MAX_COMBINED_TEXTURE_IMAGE_UNITS)")
+  result = GLint(compileSlot)
+  compileSlot += 1
+
 proc createTexture[T](game: var RootGame, uniLoc: GLint, texture: Texture[T]): tuple[unit: GLint, textureNum: GLuint] =
-  let unit = game.texCount
+  let unit = nextPoolUnit()
   game.texCount += 1
   var textureNum: GLuint
   glGenTextures(1, textureNum.addr)
